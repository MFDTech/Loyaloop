# Copia este archivo como .env en el servidor y llena los valores.

# Dominio que apunta a la IP del VPS (registros A de @ y www en Cloudflare, nube gris).
# www redirige al dominio principal.
DOMAIN=loyaloop.com.mx
PUBLIC_URL=https://loyaloop.com.mx

# Contraseña larga y aleatoria para la base de datos (por ejemplo: openssl rand -base64 32).
POSTGRES_PASSWORD=

# Mientras no haya proveedor de SMS ni de correo, PREVIEW=true muestra los códigos en pantalla.
# Apágalo (false) en cuanto estén conectados.
PREVIEW=true
# Pestaña "Pruebas" del administrador para simular cobros. Solo para el piloto.
SIMULATOR=false
# Compilar la app con las cuentas de prueba visibles. Solo para un servidor de pruebas.
VITE_PREVIEW=false

# Firma secreta de las notificaciones de Mercado Pago (Tus integraciones → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# Google Wallet: ID de emisor (Google Pay & Wallet Console) y archivo JSON de la cuenta de servicio.
# Guarda el JSON en ./secrets/google-wallet.json en el servidor (nunca en GitHub).
GOOGLE_WALLET_ISSUER_ID=3388000000023205468
GOOGLE_WALLET_KEY_FILE=/app/secrets/google-wallet.json

# Correo (resend.com). Sin llave, las invitaciones y los cambios de contraseña solo quedan en el registro.
RESEND_API_KEY=
EMAIL_FROM=LoyaLoop <notificaciones@loyaloop.com.mx>
# A dónde llegan las respuestas (por ejemplo una dirección reenviada a tu Gmail con Cloudflare Email Routing).
EMAIL_REPLY_TO=hola@loyaloop.com.mx
