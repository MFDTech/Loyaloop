# Copia este archivo como .env en el servidor y llena los valores.

# Dominio que apunta a la IP del VPS (registros A de @ y www en Cloudflare, nube gris).
# www redirige al dominio principal.
DOMAIN=loyaloop.com.mx
PUBLIC_URL=https://loyaloop.com.mx

# Contraseña larga y aleatoria para la base de datos (por ejemplo: openssl rand -base64 32).
POSTGRES_PASSWORD=

# Mientras no haya Twilio ni correo, PREVIEW=true muestra los códigos en pantalla.
# Apágalo (false) en cuanto estén conectados.
PREVIEW=true
# Pestaña "Pruebas" del administrador para simular cobros. Solo para el piloto.
SIMULATOR=false
# Compilar la app con las cuentas de prueba visibles. Solo para un servidor de pruebas.
VITE_PREVIEW=false

# Firma secreta de las notificaciones de Mercado Pago (Tus integraciones → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# Cobro mensual a los negocios (suscripciones de Mercado Pago en la cuenta de LoyaLoop, no la de los negocios).
# Access token de producción (APP_USR-…) y firma secreta de sus notificaciones. Ver docs/backend.md.
BILLING_MP_ACCESS_TOKEN=
BILLING_MP_WEBHOOK_SECRET=

# Google Wallet: ID de emisor (Google Pay & Wallet Console) y archivo JSON de la cuenta de servicio.
# Guarda el JSON en ./secrets/google-wallet.json en el servidor (nunca en GitHub).
GOOGLE_WALLET_ISSUER_ID=3388000000023205468
GOOGLE_WALLET_KEY_FILE=/app/secrets/google-wallet.json

# Correo (resend.com). Sin llave, las invitaciones y los cambios de contraseña solo quedan en el registro.
RESEND_API_KEY=
EMAIL_FROM=LoyaLoop <notificaciones@loyaloop.com.mx>
# A dónde llegan las respuestas (por ejemplo una dirección reenviada a tu Gmail con Cloudflare Email Routing).
EMAIL_REPLY_TO=hola@loyaloop.com.mx

# Apple Wallet: Pass Type ID y Team ID (developer.apple.com) y los certificados en ./secrets (nunca en GitHub).
# Mientras falten, el botón «Agregar a Apple Wallet» muestra un aviso. Ver docs/backend.md → Apple Wallet.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=/app/secrets/apple-pass.pem
APPLE_PASS_KEY=/app/secrets/apple-pass.key
APPLE_WWDR_CERT=/app/secrets/apple-wwdr.pem

# Copia de los respaldos en Cloudflare R2 (fuera del VPS). Ver docs/backend.md → Respaldos fuera del servidor.
R2_ACCOUNT_ID=
R2_BUCKET=loyaloop-respaldos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Códigos de registro por SMS con Twilio Verify (twilio.com). Ver docs/backend.md → Twilio Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# sms (recomendado para empezar) o whatsapp
TWILIO_VERIFY_CHANNEL=sms

# Códigos de registro por WhatsApp directo con Meta (más barato). Si está configurado, gana sobre Twilio.
# Ver docs/backend.md → WhatsApp con Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=codigo_registro
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
